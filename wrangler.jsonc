{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "athar-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  // مغلق: العناوين المعتمدة على athar.date وحدها.
  //
  // عنوان workers.dev يبقى بابًا ثانيًا للخدمة نفسها: يُفهرس، ويُنسخ في
  // رسالة لعميل، ثم يُعطَّل يومًا فيظهر العطل عند من حفظه لا عندنا. وقد
  // وقع هذا فعلًا — واجهة الصيدلية كانت تناديه فسقط الدخول كله.
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // قاعدة توجيه صريحة لا نطاقًا مخصّصًا.
  //
  // كان `custom_domain: true`، وافترضتُ أنه يسبق `*.athar.date/*` في محرك
  // المطاعم. لم يفعل: بعد نشر النمط صار `console.athar.date` يعرض لوحة
  // المطاعم. القواعد تتنافس بالتخصيص، وهذه أخصّ من النمط فتغلبه.
  //
  // سجل DNS لا يلزم: `*.athar.date` الشامل يغطّي هذا المضيف أصلًا.
  "routes": [
    { "pattern": "console.athar.date/*", "zone_name": "athar.date" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "athar-console",
      "database_id": "298b29d2-9d08-4853-86d1-3ec0b16c1377",
      "migrations_dir": "./migrations"
    },
    // قواعد المنتجات مربوطة للقراءة فقط لغرض النسخ الاحتياطي المجدول.
    // ربطها مباشرة يغني عن رمز API لحساب كلاودفلير كاملًا، وهو سرّ أوسع
    // صلاحية بكثير من قراءة أربع قواعد.
    {
      "binding": "BACKUP_RESTAURANT",
      "database_name": "restaurant-db",
      "database_id": "14685e7f-b0fe-4803-808f-2e463d0394ea"
    },
    {
      "binding": "BACKUP_SCHOOL",
      "database_name": "school-db",
      "database_id": "fc6593ed-db7b-4b6e-bedf-ff1d65a4906a"
    },
    {
      "binding": "BACKUP_PHARMA",
      "database_name": "pharma-db",
      "database_id": "bff19fd4-5831-4848-a4f5-1bc3ac281001"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "athar-backups"
    }
  ],

  // كل ليلة 02:10 بتوقيت UTC — بعد منتصف الليل محليًا، فالنسخة تلتقط يومًا
  // كاملًا منتهيًا لا يومًا نصفه في الماضي ونصفه في المستقبل.
  "triggers": {
    "crons": ["10 2 * * *"]
  },
  "services": [
    {
      "binding": "PHARMA_ADAPTER",
      "service": "pharma-sync-api"
    },
    {
      "binding": "SCHOOL_ADAPTER",
      "service": "athar-school-api"
    },
    {
      "binding": "RESTAURANT_ADAPTER",
      "service": "athar-restaurant-api"
    },
    // موقع أثر التعريفي: يُنادى لسحب العملاء المحتملين من نموذج التواصل.
    {
      "binding": "SITE_ADAPTER",
      "service": "athar-site"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
